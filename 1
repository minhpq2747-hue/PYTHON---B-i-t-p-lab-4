import threading

lock = threading.Lock()


def write_logs(thread_id):
    with lock:
        with open("logs.txt", "a", encoding="utf-8") as file:
            for i in range(1, 11):
                file.write(f"Thread-{thread_id}: log {i}\n")


with open("logs.txt", "w", encoding="utf-8") as file:
    file.write("")

threads = []

for i in range(1, 4):
    thread = threading.Thread(target=write_logs, args=(i,))
    threads.append(thread)
    thread.start()

for thread in threads:
    thread.join()

with open("logs.txt", "r", encoding="utf-8") as file:
    lines = file.readlines()

print("Tong so dong log:", len(lines))
print("So dong hop le:", sum(
    1 for line in lines
    if line.strip() and line.startswith(("Thread-1:", "Thread-2:", "Thread-3:"))
))
print("So dong khong trung:", len(set(lines)))
print("Xac nhan:", len(lines) == 30 and len(set(lines)) == 30)
print("Noi dung file:")
print("".join(lines))
