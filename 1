import os
import time
import threading

FILE_NAME = "watched.txt"
stop_event = threading.Event()


def watch_file():
    previous_content = ""

    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r", encoding="utf-8") as file:
            previous_content = file.read()

    start_time = time.time()

    while time.time() - start_time < 30 and not stop_event.is_set():
        if os.path.exists(FILE_NAME):
            with open(FILE_NAME, "r", encoding="utf-8") as file:
                current_content = file.read()

            if current_content != previous_content:
                new_content = current_content[len(previous_content):]
                print("Noi dung moi:", new_content)
                previous_content = current_content

        stop_event.wait(3)


def simulate_user():
    for i in range(1, 6):
        if stop_event.wait(5):
            break

        with open(FILE_NAME, "a", encoding="utf-8") as file:
            file.write(f"User added line {i}\n")


with open(FILE_NAME, "w", encoding="utf-8") as file:
    file.write("")

watcher = threading.Thread(target=watch_file)
user = threading.Thread(target=simulate_user)

watcher.start()
user.start()

watcher.join()
stop_event.set()
user.join()

print("Da dung theo doi file.")
