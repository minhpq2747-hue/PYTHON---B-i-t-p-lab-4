import os
import time
import threading

SOURCE = "source.txt"
TARGET_THREAD = "target.txt"
TARGET_NORMAL = "target_normal.txt"
CHUNK_SIZE = 1024 * 1024


def copy_file(source, target, use_thread=False):
    total_size = os.path.getsize(source)
    copied = 0

    with open(source, "rb") as src, open(target, "wb") as dst:
        while True:
            chunk = src.read(CHUNK_SIZE)
            if not chunk:
                break

            dst.write(chunk)
            copied += len(chunk)

            if use_thread:
                print(f"\rDa copy: {copied}/{total_size} bytes", end="")

    if use_thread:
        print()


def threaded_copy():
    copy_file(SOURCE, TARGET_THREAD, True)


start = time.perf_counter()
thread = threading.Thread(target=threaded_copy)
thread.start()
thread.join()
thread_time = time.perf_counter() - start

start = time.perf_counter()
copy_file(SOURCE, TARGET_NORMAL)
normal_time = time.perf_counter() - start

with open(SOURCE, "rb") as f:
    source_data = f.read()

with open(TARGET_THREAD, "rb") as f:
    target_data = f.read()

print("Thoi gian copy bang thread:", thread_time, "giay")
print("Thoi gian copy binh thuong:", normal_time, "giay")
print("File dich giong file goc:", source_data == target_data)
