import json


def load_tasks():
    try:
        with open("todo.json", "r", encoding="utf-8") as file:
            return json.load(file)
    except FileNotFoundError:
        return []
    except json.JSONDecodeError:
        print("File todo.json bi loi dinh dang JSON.")
        return []


def add_task(tasks, title):
    task = {
        "id": len(tasks) + 1,
        "title": title,
        "completed": False
    }

    tasks.append(task)

    with open("todo.json", "w", encoding="utf-8") as file:
        json.dump(tasks, file, ensure_ascii=False, indent=4)


tasks = load_tasks()

add_task(tasks, "Hoc Python")
add_task(tasks, "Lam bai tap")
tasks = load_tasks()

print("Danh sach task:")
for task in tasks:
    print(task)
